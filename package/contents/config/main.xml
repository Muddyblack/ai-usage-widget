<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <entry name="claudeEnabled" type="Bool">
      <default>false</default>
    </entry>
    <entry name="antigravityEnabled" type="Bool">
      <default>false</default>
    </entry>
    <entry name="openaiEnabled" type="Bool">
      <default>false</default>
    </entry>
    <entry name="kiroEnabled" type="Bool">
      <default>false</default>
    </entry>
    <!-- API keys stored in plasmoid config (user's KDE wallet area, not world-readable) -->
    <entry name="claudeAdminApiKey" type="String">
      <default></default>
    </entry>
    <entry name="openaiApiKey" type="String">
      <default></default>
    </entry>
    <entry name="mistralEnabled" type="Bool">
      <default>false</default>
    </entry>
    <entry name="openrouterEnabled" type="Bool">
      <default>false</default>
    </entry>
    <entry name="ollamaEnabled" type="Bool">
      <default>false</default>
    </entry>
    <entry name="selfhostedEnabled" type="Bool">
      <default>false</default>
    </entry>
    <entry name="selfhostedEndpoint" type="String">
      <default></default>
    </entry>
    <entry name="selfhostedEngine" type="String">
      <default>auto</default>
    </entry>
    <entry name="selfhostedKey" type="String">
      <default></default>
    </entry>
    <entry name="grokEnabled" type="Bool">
      <default>false</default>
    </entry>
    <entry name="zaiEnabled" type="Bool">
      <default>false</default>
    </entry>
    <entry name="copilotEnabled" type="Bool">
      <default>false</default>
    </entry>
    <entry name="deepseekEnabled" type="Bool">
      <default>false</default>
    </entry>
    <entry name="kimiEnabled" type="Bool">
      <default>false</default>
    </entry>
    <entry name="cursorEnabled" type="Bool">
      <default>false</default>
    </entry>
    <entry name="clineEnabled" type="Bool">
      <default>false</default>
    </entry>
    <entry name="museEnabled" type="Bool">
      <default>false</default>
    </entry>
    <entry name="opencodeEnabled" type="Bool">
      <default>false</default>
    </entry>
    <entry name="providerDefaultsApplied" type="Bool">
      <default>false</default>
    </entry>
    <entry name="museQuotaEnabled" type="Bool">
      <default>false</default>
    </entry>
    <!-- Optional popup views ahead of provider tabs (mirrors FeatureTabs.js) -->
    <entry name="overviewEnabled" type="Bool">
      <default>false</default>
    </entry>
    <entry name="spendEnabled" type="Bool">
      <default>false</default>
    </entry>
    <entry name="sessionsEnabled" type="Bool">
      <default>true</default>
    </entry>
    <entry name="costHistoryDays" type="Int">
      <default>30</default>
    </entry>
    <entry name="costHistoryMetric" type="String">
      <default>cost</default>
    </entry>
    <entry name="museApiKey" type="String">
      <default></default>
    </entry>
    <entry name="mistralApiKey" type="String">
      <default></default>
    </entry>
    <entry name="openrouterApiKey" type="String">
      <default></default>
    </entry>
    <entry name="ollamaApiKey" type="String">
      <default></default>
    </entry>
    <entry name="grokApiKey" type="String">
      <default></default>
    </entry>
    <entry name="zaiToken" type="String">
      <default></default>
    </entry>
    <entry name="githubToken" type="String">
      <default></default>
    </entry>
    <entry name="deepseekApiKey" type="String">
      <default></default>
    </entry>
    <entry name="moonshotApiKey" type="String">
      <default></default>
    </entry>
    <entry name="copilotQuota" type="Int">
      <default>300</default>
    </entry>
    <entry name="showUsageChart" type="Bool">
      <default>true</default>
    </entry>
    <entry name="weeklyUsageHistory" type="String">
      <default></default>
    </entry>
    <!-- Unified usage history: JSON array of {t, s, w} (session %, weekly %). Migrated from weeklyUsageHistory. -->
    <entry name="usageHistory" type="String">
      <default></default>
    </entry>
    <!-- Accent color mode: true = follow Plasma accent (highlightColor), false = per-service colors -->
    <entry name="useThemeAccent" type="Bool">
      <default>false</default>
    </entry>
    <!-- Comma-separated pinned tab ids (e.g. "claude,openai"); empty = show active tab -->
    <entry name="pinnedTab" type="String">
      <default></default>
    </entry>
    <!-- Chart window: "weekly" (7d), "day" (24h) or "session" (5h); codex_* variants for the OpenAI tab -->
    <entry name="chartWindow" type="String">
      <default>weekly</default>
    </entry>
    <!-- Remembered chart granularity ("5h" | "24h" | "7d" | "30d"), shared across tabs so the time range carries when switching services -->
    <entry name="chartGranularity" type="String">
      <default>7d</default>
    </entry>
    <!-- Antigravity model filter: "both", "combined", "gemini", or "rest" -->
    <entry name="antigravityChartFilter" type="String">
      <default>both</default>
    </entry>
    <!-- Poll interval in seconds (applies to all services) -->
    <entry name="pollIntervalSec" type="Int">
      <default>300</default>
    </entry>
    <!-- Compact Plasma panel rotation interval; 0 keeps the existing pin display -->
    <entry name="panelRotationIntervalSec" type="Int">
      <default>0</default>
    </entry>
    <!-- Interpreter for the shell tools, exported as $PYTHON3. Empty = let
         tools/sh/python-interp.sh search PATH. Set it to pin a specific
         interpreter, e.g. a virtualenv's bin/python. -->
    <entry name="pythonPath" type="String">
      <default></default>
    </entry>
    <!-- Appearance customizations -->
    <entry name="cardBgColor" type="String">
      <default>#100a1a</default>
    </entry>
    <entry name="cardBgOpacity" type="Double">
      <default>0.90</default>
    </entry>
    <entry name="popupBgColor" type="String">
      <default>#000000</default>
    </entry>
    <entry name="popupBgOpacity" type="Double">
      <default>0.00</default>
    </entry>
    <entry name="backgroundHints" type="Int">
      <default>1</default>
    </entry>
    <entry name="popupDecoration" type="Int">
      <default>0</default>
    </entry>
  </group>
</kcfg>
